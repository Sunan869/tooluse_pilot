# Local credentials and machine-specific configuration
.env
.env.*
!.env.example
!.env.sample
gateway*.json
!gateway*.example.json
*.local.json
credentials*.json
secrets*.json
*.pem
*.key

# Python environments, generated bytecode and tool caches
.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.coverage
.coverage.*
htmlcov/
build/
dist/
*.egg-info/

# Logs, local databases and downloaded archives
*.log
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.db
*.db-*
downloads/
*.zip
*.7z
*.tar
*.tar.gz
*.whl

# Experiment evidence stays on disk. Keep reusable source at its original path.
/runs/**
!/runs/**/
!/runs/**/*.py
!/runs/**/*.ps1
!/runs/**/*.sh
!/runs/**/*.patch
!/runs/**/tests/*fixture*.txt
# Exceptions above must never admit generated caches or environments.
/runs/**/__pycache__/
/runs/**/.venv/

# Generated example executions (curated inputs/oracles remain tracked)
/examples/**/runs/
/examples/**/trace.json
/examples/**/output/
/examples/**/private/initial_submission.csv
/examples/**/private/revision_applied.json

# Editor/OS temporary files
.idea/
.vscode/
.DS_Store
Thumbs.db
~$*
*.tmp
